# Шаблон .env: скопировать в .env и заполнить. Сам .env в git не попадает.
# Читает только src/lib/settings.py. Переменная из окружения важнее значения в .env.

# Подключение к серверу ClickHouse (clickhouse-client)
CH_HOST=
CH_PORT=
CH_USER=
CH_PSWD=

# Корень данных, если он не в data/ проекта (например, на сервере).
# Перекрывает paths.data из config.yaml.
# DF_DATA_DIR=/path/to/data
